PORT=5000
NODE_ENV=development
AUTH_PHASE=1
DATABASE_MODE=local
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/authshield360
MONGO_URI=
FRONTEND_URL=http://localhost:3000
MFA_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Mailtrap Email Testing (sandbox) or Email Sending SMTP credentials.
# Copy the host and credentials shown in your Mailtrap SMTP settings.
SMTP_HOST=
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=